# Le serveur : un conteneur, un langage.
#
# Il remplace les deux images d'avant — celle qui servait des fichiers et celle
# qui relisait un dossier toutes les cinq secondes. Il sert l'application, les
# échantillons, les dossiers de données, et mesure la vraie voiture dès qu'une
# trace arrive, puisque c'est lui qui l'écrit.
#
# Publié sur le registre de conteneurs GitHub par .github/workflows/docker.yml.

# --- L'application et le serveur, assemblés ---------------------------------
#
# `--platform=$BUILDPLATFORM` n'est pas un détail : sans lui, produire une image
# pour un NAS à processeur ARM ferait tourner npm sous émulation, pour de
# longues minutes. Avec lui, l'assemblage se fait nativement sur le runner.
FROM --platform=$BUILDPLATFORM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Les écrans de banc — simulateur de vitesse et réglage de la synthèse — ne sont
# dans l'image que si on le demande. Un simulateur de vitesse dans une voiture
# n'est qu'un moyen de se tromper sur ce qu'on entend.
ARG BENCH=""
RUN BENCH=$BENCH npm run build && npm run build:serveur

# Les dépendances de production, installées **pour l'architecture visée depuis
# celle du runner**.
#
# Le pilote de la base est un binaire livré par plateforme, et npm prend par
# défaut celui de la machine qui installe. C'est ce qui faisait installer sur
# l'architecture visée, donc sous émulation — et `npm ci` y mourait d'une
# instruction illégale rendue par QEMU, plus d'une construction sur deux.
# `--cpu`, `--os` et `--libc` disent à npm pour qui il installe : l'émulation
# disparaît au lieu d'être contournée.
#
# **`TARGETARCH` ne parle pas la même langue que `--cpu`** : buildx dit `amd64`
# là où npm attend `x64`. Mesuré : avec `--cpu=amd64`, npm n'installe **aucun**
# binaire et ne dit rien. D'où la traduction — et le `test -d`, qui n'est pas une
# ceinture de plus : une image à qui le binaire manque se construit sans erreur
# et meurt au démarrage, loin de sa cause.
ARG TARGETARCH
RUN set -e; \
    case "$TARGETARCH" in \
      amd64) CPU=x64 ;; \
      arm64) CPU=arm64 ;; \
      *) echo "architecture inconnue : $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    npm ci --omit=dev --ignore-scripts --cpu="$CPU" --os=linux --libc=musl; \
    test -d "node_modules/@libsql/linux-$CPU-musl"; \
    npm cache clean --force; \
    mv node_modules /prod_node_modules

# --- Ce qui tourne ----------------------------------------------------------
#
# Cet étage-ci est le seul que buildx construit une fois par architecture, donc
# le seul qui passe sous émulation. Il n'y **exécute** plus rien : que des
# copies, que QEMU ne touche pas.
FROM node:22-alpine
WORKDIR /app

COPY package.json ./
COPY --from=build /prod_node_modules ./node_modules

# L'application construite, le serveur assemblé, et les migrations qu'il joue au
# démarrage. Celles-ci sont des fichiers SQL versionnés : le serveur les lit, il
# ne les contient pas.
COPY --from=build /app/dist ./dist
COPY --from=build /app/dist-serveur ./dist-serveur
COPY --from=build /app/src/server/base/migrations ./migrations

ENV SPEED_APP=/app/dist
ENV SPEED_MIGRATIONS=/app/migrations
ENV SPEED_DB=/data/speed.db
ENV SPEED_AUDIO=/data/audio
ENV SPEED_PORT=80

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q -O /dev/null http://localhost/index.html || exit 1

CMD ["node", "dist-serveur/serveur.js"]

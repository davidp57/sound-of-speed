node_modules/
dist/
.DS_Store
*.local

# Échantillons moteur : jamais versionnés.
# Servis par Vite depuis public/, mais rien n'y est référencé en dur — chaque
# profil déclare son sous-dossier et la liste de ses couches.
public/audio/
tsconfig.tsbuildinfo

# Fichier de mots de passe produit par `npm run htpasswd`. Il n'a rien à faire
# dans un dépôt — a fortiori s'il devient public un jour.
htpasswd

# Relevés de mesure écrits par un test de sonde, le temps d'un diagnostic.
mesures.txt
sonde.txt

# Rapports de couverture : produits par `npm run coverage`, jamais partagés.
.coverage/
coverage/

# Réglages de Claude Code propres au poste, et copies de travail des branches
# créées sous .claude/worktrees/ : ni les uns ni les autres ne se partagent.
.claude/settings.local.json
.claude/worktrees/

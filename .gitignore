node_modules/
dist/
.DS_Store
*.local

# Échantillons moteur : jamais versionnés.
# Servis par Vite depuis public/, mais rien n'y est référencé en dur — chaque
# profil déclare son sous-dossier et la liste de ses couches.
#
# Le contenu est exclu, et non le dossier lui-même : git n'entre pas dans un
# dossier exclu, donc `public/audio/` suivi d'une exception ne ramènerait rien.
public/audio/*

# Les exceptions : les banques **produites au banc**, qui n'appartiennent à
# personne et pèsent 4,2 Mo en FLAC à elles trois. Sans elles, qui clone le
# dépôt obtient une application de son qui ne fait aucun son — les tirer du
# réseau au moment de construire l'image casserait le clone autonome pour
# économiser un poids qu'on peut se permettre.
#
# Une banque **enregistrée** ne passera jamais ici : une prise sur une vraie
# voiture appartient à qui l'a faite, et `procar` vient d'une autre application.
!public/audio/gm-ls/
!public/audio/gm-ls-long-header/
!public/audio/gm-ls-adouci/
!public/audio/bmw-i6-3l/
!public/audio/subaru-ej25/

# Le dossier de travail de la chaîne de fabrication, qui vit **dans** la banque
# qu'elle produit : ré-inclure les quatre banques livrées le ramenait avec
# elles. Un WAV non compressé y pèse 260 ko, et une génération complète en
# écrit une centaine.
public/audio/*/.brut/
tsconfig.tsbuildinfo

# Fichier de mots de passe produit par `npm run htpasswd`. Il n'a rien à faire
# dans un dépôt — a fortiori s'il devient public un jour.
htpasswd

# Relevés de mesure écrits par un test de sonde, le temps d'un diagnostic.
mesures.txt
sonde.txt

# Rapports de couverture : produits par `npm run coverage`, jamais partagés.
.coverage/
coverage/

# Réglages de Claude Code propres au poste, et copies de travail des branches
# créées sous .claude/worktrees/ : ni les uns ni les autres ne se partagent.
.claude/settings.local.json
.claude/worktrees/

# Fichier d essai du dépôt de traces, produit à la main sur le poste.
essai.json

# Ce qu'em++ laisse tomber quand une commande de compilation casse en
# chemin : deux fichiers a.out a la racine, qui ont déjà été commités une
# fois et fait échouer le contrôle qualité.
a.out.js
a.out.wasm

# Fichiers de verrouillage d'Excel, créés à l'ouverture d'un classeur
~$*
dist-profileur/

# Le secret qui signe les connexions, écrit par le serveur à côté de sa base au
# premier démarrage. Il ne se partage pas, et un dépôt public le rendrait inutile.
identite.secret

# Bases de données locales, créées en développement ou par un test qui n'a pas
# pu faire son ménage. Ce qui compte est versionné à côté : le schéma et ses
# migrations.
*.db
*.db-shm
*.db-wal
dist-serveur/

{
  "name": "sound-of-speed",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.2.25",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "cross-env HTTPS=1 vite",
    "relecteur": "cross-env SPEED_DATA=//Salon/docker/sound-of-speed vite",
    "build": "vue-tsc -b && vite build",
    "build:profileur": "esbuild src/server/profileur/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist-profileur/profileur.js",
    "profileur": "npm run build:profileur && node dist-profileur/profileur.js",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "accord": "node scripts/accord/accord.mjs",
    "base:migrations": "drizzle-kit generate",
    "serveur": "npm run build:serveur && node dist-serveur/serveur.js",
    "coverage": "vitest run --coverage",
    "banque": "node scripts/banque.mjs",
    "transcode": "node scripts/transcode.mjs",
    "deploy": "node scripts/deploy.mjs",
    "icons": "node scripts/icons.mjs",
    "silence": "node scripts/silence.mjs",
    "htpasswd": "node scripts/htpasswd.mjs",
    "analyse-son": "node scripts/analyse-son/index.mjs",
    "build:serveur": "esbuild src/server/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist-serveur/serveur.js",
    "build:verdict": "esbuild src/server/verdict.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist-serveur/verdict.js",
    "verdict": "npm run build:verdict && node dist-serveur/verdict.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@libsql/client": "^0.18.0",
    "@types/leaflet": "^1.9.22",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "leaflet": "^1.9.4",
    "qrcode-generator": "^2.0.4",
    "vue": "^3.5.13",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "bcryptjs": "^3.0.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
